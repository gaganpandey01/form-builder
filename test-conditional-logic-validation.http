}

### Test 6: Invalid - Operator Not Compatible with Field Type
POST http://localhost:5070/api/forms
Content-Type: application/json

{
    "title": "Invalid - Operator Not Compatible",
    "fields": [
        {
            "id": "field1",
            "type": "text",
            "label": "Text Field"
        },
        {
            "id": "field2",
            "type": "text",
            "label": "Dependent Field",
            "conditionalLogic": {
                "enabled": true,
                "condition": "show",
                "rules": [
                    {
                        "fieldId": "field1",
                        "operator": "greater_than",
                        "value": "10"
                    }
                ]
            }
        }
    ]
}

### Test 7: Valid - Complex Multi-Rule Logic
POST http://localhost:5070/api/forms
Content-Type: application/json

{
    "title": "Valid - Complex Multi-Rule Logic",
    "fields": [
        {
            "id": "age",
            "type": "number",
            "label": "Age"
        },
        {
            "id": "country",
            "type": "select",
            "label": "Country",
            "options": ["USA", "Canada"]
        },
        {
            "id": "special_field",
            "type": "text",
            "label": "Special Field",
            "conditionalLogic": {
                "enabled": true,
                "condition": "show",
                "operator": "and",
                "rules": [
                    {
                        "fieldId": "age",
                        "operator": "greater_than",
                        "value": "18"
                    },
                    {
                        "fieldId": "country",
                        "operator": "equals",
                        "value": "USA"
                    }
                ]
            }
        }
    ]
}